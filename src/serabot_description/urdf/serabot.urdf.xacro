<?xml version="1.0"?>
<robot name="serabot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ===== Parametreler ===== -->
  <!-- Gövde -->
  <xacro:property name="body_length" value="0.45"/>
  <xacro:property name="body_width"  value="0.30"/>
  <xacro:property name="body_height" value="0.12"/>
  <xacro:property name="body_mass"   value="5.0"/>
  <xacro:property name="ground_clearance" value="0.04"/>

  <!-- Tekerlekler (gövdenin ön yarısında) -->
  <xacro:property name="wheel_radius" value="0.07"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>
  <xacro:property name="wheel_x"      value="0.10"/>
  <xacro:property name="wheel_gap"    value="0.005"/>

  <!-- Arka küresel caster -->
  <xacro:property name="caster_radius" value="${ground_clearance/2}"/>
  <xacro:property name="caster_mass"   value="0.1"/>
  <xacro:property name="caster_x"      value="-0.17"/>

  <!-- Direk -->
  <xacro:property name="mast_radius" value="0.015"/>
  <xacro:property name="mast_height" value="0.25"/>
  <xacro:property name="mast_mass"   value="0.2"/>
  <xacro:property name="mast_x"      value="-0.15"/>

  <!-- LiDAR ve kaidesi -->
  <xacro:property name="lidar_x"        value="0.15"/>
  <xacro:property name="lidar_radius"   value="0.035"/>
  <xacro:property name="lidar_height"   value="0.04"/>
  <xacro:property name="lidar_mass"     value="0.15"/>
  <xacro:property name="pedestal_radius" value="0.03"/>
  <xacro:property name="pedestal_height" value="0.03"/>

  <!-- Kamera -->
  <xacro:property name="camera_size_x" value="0.03"/>
  <xacro:property name="camera_size_y" value="0.06"/>
  <xacro:property name="camera_size_z" value="0.03"/>
  <xacro:property name="camera_mass"   value="0.05"/>
  <xacro:property name="camera_pitch"  value="${10*pi/180}"/>

  <!-- Durum lambası -->
  <xacro:property name="lamp_radius" value="0.025"/>
  <xacro:property name="lamp_height" value="0.03"/>
  <xacro:property name="lamp_x"      value="-0.03"/>

  <!-- Türetilen değerler -->
  <xacro:property name="base_z" value="${ground_clearance + body_height/2}"/>
  <xacro:property name="wheel_y" value="${body_width/2 + wheel_width/2 + wheel_gap}"/>

  <!-- ===== Renkler ===== -->
  <material name="green">  <color rgba="0.20 0.60 0.25 1"/></material>
  <material name="black">  <color rgba="0.05 0.05 0.05 1"/></material>
  <material name="grey">   <color rgba="0.50 0.50 0.50 1"/></material>
  <material name="dark">   <color rgba="0.15 0.15 0.20 1"/></material>
  <material name="orange"> <color rgba="1.00 0.50 0.00 1"/></material>

  <!-- ===== base_footprint: zemindeki referans frame ===== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== Gövde ===== -->
  <link name="base_link">
    <visual>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="green"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ===== Tahrikli tekerlekler ===== -->
  <xacro:macro name="wheel" params="prefix y_sign">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- Dış yüzdeki gri şerit: tekerleğin döndüğü gözle görülebilsin -->
      <visual>
        <origin xyz="0 ${y_sign*(wheel_width/2 + 0.001)} 0" rpy="0 0 0"/>
        <geometry><box size="${1.6*wheel_radius} 0.002 0.015"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x} ${y_sign*wheel_y} ${wheel_radius - base_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  y_sign="1"/>
  <xacro:wheel prefix="right" y_sign="-1"/>

  <!-- ===== Arka küresel caster ===== -->
  <link name="caster_link">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="${caster_mass}" radius="${caster_radius}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius - base_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== Direk ===== -->
  <link name="mast_link">
    <visual>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${mast_radius}" length="${mast_height}"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="${mast_mass}" radius="${mast_radius}" length="${mast_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast_link"/>
    <origin xyz="${mast_x} 0 ${body_height/2 + mast_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===== LiDAR (kaide dahil). lidar_link orijini = tarama düzlemi ===== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0 0 ${-(lidar_height/2 + pedestal_height/2)}" rpy="0 0 0"/>
      <geometry><cylinder radius="${pedestal_radius}" length="${pedestal_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${-pedestal_height/2}" rpy="0 0 0"/>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height + pedestal_height}"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} 0 ${body_height/2 + pedestal_height + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===== Kamera (direğin tepesinde, ~10° aşağı bakıyor) ===== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <geometry><box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/></geometry>
    </collision>
    <xacro:inertial_box mass="${camera_mass}" x="${camera_size_x}" y="${camera_size_y}" z="${camera_size_z}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="mast_link"/>
    <child link="camera_link"/>
    <origin xyz="${mast_radius + camera_size_x/2} 0 ${mast_height/2}" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <!-- ===== IMU (gövde merkezinde) ===== -->
  <link name="imu_link"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===== Durum lambası (sadece görsel) ===== -->
  <link name="lamp_link">
    <visual>
      <geometry><cylinder radius="${lamp_radius}" length="${lamp_height}"/></geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="lamp_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lamp_link"/>
    <origin xyz="${lamp_x} 0 ${body_height/2 + lamp_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ===== Gazebo plugin'leri (yukarıdaki parametreleri kullanır) ===== -->
  <xacro:include filename="serabot_gazebo.xacro"/>

  <!-- ===== Sensörler ===== -->
  <xacro:include filename="serabot_sensors.xacro"/>

</robot>
