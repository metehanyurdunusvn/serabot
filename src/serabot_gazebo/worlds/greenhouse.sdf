<?xml version="1.0" ?>
<!-- SeraBot sera dünyası: duvarlarla çevrili 10 x 6 m sera (x: -5..5, y: -3..3) -->
<sdf version="1.10">
  <world name="greenhouse">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sistem plugin'leri -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Sensör sistemleri: bunlar olmadan LiDAR, kamera ve IMU veri basmaz -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Zemin (toprak rengi) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.45 0.36 0.26 1</ambient>
            <diffuse>0.45 0.36 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sera duvarları (1 m yüksek, 0.1 m kalın) -->
    <model name="greenhouse_walls">
      <static>true</static>
      <link name="wall_north">
        <pose>0 3.05 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.80 0.80 1</ambient>
            <diffuse>0.75 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_south">
        <pose>0 -3.05 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.1 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.80 0.80 1</ambient>
            <diffuse>0.75 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_east">
        <pose>5.05 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.80 0.80 1</ambient>
            <diffuse>0.75 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>-5.05 0 0.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 6.0 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.80 0.80 1</ambient>
            <diffuse>0.75 0.80 0.80 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
